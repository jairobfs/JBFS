{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cpop-linguagens-preview",
  "main": "./cloudflare/worker.mjs",
  "compatibility_date": "2026-11-03",
  "workers_dev": true,
  "assets": {
    "directory": "./.cloudflare-public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
